{
  "name": "nuxt-backend-lens",
  "version": "0.0.0",
  "description": "Debugbar-like panel for Nuxt SPAs: the SQL, logs and timing behind every backend request (Clockwork, Laravel Debugbar)",
  "repository": "",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.4",
    "@nuxt/kit": "^4.6.3",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0 || ^5.0.0",
    "vue-tsc": "^3.3.12"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "devtools",
    "clockwork",
    "debugbar",
    "laravel",
    "sql",
    "n+1",
    "profiler"
  ],
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0 || ^5.0.0"
  }
}
