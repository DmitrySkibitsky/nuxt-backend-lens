{
  "name": "nuxt-backend-lens-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "format": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "check:push": "pnpm lint && pnpm -F nuxt-backend-lens test:types && pnpm -F nuxt-backend-lens test",
    "test:leak": "node --env-file-if-exists=demo/.env tests/leak/leak-test.mjs",
    "test:e2e": "node --env-file-if-exists=demo/.env node_modules/@playwright/test/cli.js test",
    "test:package": "node tests/package/check.mjs",
    "demo:gif": "node --env-file-if-exists=demo/.env scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "^1.64.1",
    "@stylistic/stylelint-config": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm -s check:push"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue,json}": "eslint --fix --no-warn-ignored",
    "*.css": "stylelint --fix --allow-empty-input",
    "demo/backend/{app,config,database,routes,tests}/**/*.php": "node scripts/pint-staged.mjs",
    "demo/backend/bootstrap/app.php": "node scripts/pint-staged.mjs"
  }
}
