# Copy to .env and adjust if a port is taken on your machine.
# Same-origin entry point: SPA + /api + /sanctum + /__clockwork + /clockwork.
DEMO_PORT=18080
# Direct backend access (leak test, cross-origin checks).
BACKEND_PORT=18000
# The SPA without proxied backend paths: its /cross-origin page calls BACKEND_PORT directly.
CROSS_ORIGIN_PORT=18081

# octane | classic
BACKEND_MODE=octane
# clockwork | debugbar
DEBUG_BACKEND=clockwork
# files | sql
CLOCKWORK_STORAGE=files

# Host user the containers run as; bin/setup appends the real values.
# HOST_UID=1000
# HOST_GID=1000
